# Required runtime configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hardware_pos
JWT_SECRET=replace_with_a_long_random_secret_value

# Optional Gemini integration
GEMINI_API_KEY=

# Optional demo login passwords
# In development, unset values fall back to ChangeMe123!
# In production, set every password explicitly to a unique secret.
ADMIN_PASSWORD=
MANAGER_PASSWORD=
WHOLESALE_MANAGER_PASSWORD=
CASHIER_PASSWORD=
INVENTORY_PASSWORD=

# Optional role-based allowed shop IDs (comma-separated)
SUPER_ADMIN_ALLOWED_SHOPS=
MANAGER_ALLOWED_SHOPS=
CASHIER_ALLOWED_SHOPS=
INVENTORY_ALLOWED_SHOPS=

# Optional fixed shop per email mapping
# Format: email=shop-id,email2=shop-id
USER_FIXED_SHOPS=

# Optional CORS/CSP hardening for deployed environments
# Comma-separated allowed browser origins (required in production if frontend domain differs)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
# Optional overrides (comma-separated)
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Shop-Id
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Additional external connect-src hosts for CSP (comma-separated), e.g. https://api.example.com
CSP_EXTRA_CONNECT_SRC=

# Optional SMTP integration for invoice email delivery
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
# Example Gmail setup:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=your-store@gmail.com
# EMAIL_SMTP_PASS=your_gmail_app_password
# EMAIL_FROM=Your Store <your-store@gmail.com>

# Optional WhatsApp Business API integration
WHATSAPP_API_URL=
WHATSAPP_MEDIA_UPLOAD_URL=
WHATSAPP_TOKEN=
# Example Meta Cloud API setup:
# WHATSAPP_API_URL=https://graph.facebook.com/v22.0/YOUR_PHONE_NUMBER_ID/messages
# WHATSAPP_MEDIA_UPLOAD_URL=https://graph.facebook.com/v22.0/YOUR_PHONE_NUMBER_ID/media
# WHATSAPP_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
