{
  "name": "hardware-shop-pos-and-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild backend/recoveryAdvancedControls.ts --bundle --platform=node --format=esm --outfile=dist/recovery-advanced-controls.mjs",
    "start": "node dist/server.cjs",
    "clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force dist, server.js -ErrorAction SilentlyContinue\"",
    "lint": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:shell": "powershell -ExecutionPolicy Bypass -File scripts/db-shell.ps1",
    "db:migrate:normalized": "powershell -ExecutionPolicy Bypass -File scripts/db-migrate-normalized.ps1",
    "db:migrate:product-image": "powershell -ExecutionPolicy Bypass -File scripts/db-migrate-product-image.ps1",
    "db:tables": "powershell -ExecutionPolicy Bypass -File scripts/db-tables.ps1",
    "db:data": "powershell -ExecutionPolicy Bypass -File scripts/db-data.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "2.4.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "6.3.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "10.6.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "8.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.2",
    "autoprefixer": "10.4.20",
    "esbuild": "0.28.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "8.4.0"
  }
}
