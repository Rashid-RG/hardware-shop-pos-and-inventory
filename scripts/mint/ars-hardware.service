[Unit]
Description=ARS Distributor POS

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ars-hardware/project
Environment=NODE_ENV=production
Environment=ARS_LISTEN_HOST=127.0.0.1
Environment=PORT=3000
Environment=CORS_ALLOWED_ORIGINS=http://localhost:3000
ExecCondition=/usr/bin/python3 -E -s -B %h/.local/share/ars-hardware/update-tools/trusted-switch-recovery.py pre-start
ExecCondition=/usr/bin/python3 %h/.local/share/ars-hardware/update-tools/startup_guard.py
ExecStartPre=/usr/bin/env docker compose -p ars-mint --env-file .env.local -f scripts/mint/compose.yaml up -d --wait
ExecStart=%h/.local/share/ars-hardware/node dist/server.cjs
TimeoutStartSec=150
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
